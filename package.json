{
  "name": "juneja",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "bun run sync:repos && astro build && bun run verify:private",
    "verify:private": "bun test scripts/private-config.test.mjs scripts/train-model-assets.test.mjs",
    "sync:repos": "bun scripts/sync-repositories.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
