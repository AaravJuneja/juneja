---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Journey from "../components/Journey.astro";
import Footer from "../components/Footer.astro";
import { allAchievements } from "../data.ts";

const teams = [...new Set(allAchievements.map((a) => a.team))].join(" and ");
---

<Layout title="journey | juneja" description={`Every CTF receipt. ${allAchievements.length} competitions across ${teams}.`}>
  <Navigation />
  <Journey />
  <Footer />
</Layout>
