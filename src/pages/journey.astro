---
import Layout from "../layouts/Layout.astro";
import Journey from "../components/Journey.astro";
import { allAchievements } from "../data.ts";

const teams = [...new Set(allAchievements.map((a) => a.team))].join(" and ");
---

<Layout title="journey" description={`Every CTF receipt. ${allAchievements.length} competitions across ${teams}.`}>
  <Journey />
</Layout>
