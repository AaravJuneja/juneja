---
import Layout from "../layouts/Layout.astro";
import Journey from "../components/Journey.astro";
import { allAchievements } from "../data.ts";

const teams = [...new Set(allAchievements.map((a) => a.team))].join(" and ");
---

<Layout title="journey" description={`${allAchievements.length} CTF results with ${teams}, 2025 to 2026`}>
  <Journey />
</Layout>
