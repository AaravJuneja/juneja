---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import TeamStory from "../components/TeamStory.astro";
import Writeups from "../components/Writeups.astro";
import Journey from "../components/Journey.astro";
import Footer from "../components/Footer.astro";
import SpotifyNowPlaying from "../components/SpotifyNowPlaying.astro";
import ArcadeRunnerLane from "../components/react/ArcadeRunnerLane.tsx";
---

<Layout>
  <Navigation />
  <div class="relative">
    <div class="marble-bg" aria-hidden="true">
      <img src="/images/marble-bg.webp" alt="" loading="eager" decoding="async" fetchpriority="low" />
      <div class="marble-shade"></div>
      <div class="hotel-fade"></div>
    </div>
    <div class="hotel-bg" aria-hidden="true">
      <img id="hotel-img" alt="" decoding="async" />
      <div class="hotel-shade"></div>
      <div class="hotel-fade"></div>
    </div>
    <div class="relative">
      <Hero />

      <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-2 flex flex-wrap gap-3 items-center justify-between">
        <SocialLinks />
        <div class="ml-auto">
          <SpotifyNowPlaying />
        </div>
      </div>

      <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-5 sm:py-8 lg:py-10">
        <ArcadeRunnerLane client:load />
      </div>
    </div>
  </div>

  <TeamStory />
  <div class="w-screen max-w-none ml-[calc(50%-50vw)] bg-surface flex items-center justify-center gap-3 py-6">
    <div class="h-px bg-line w-16 sm:w-24"></div>
    <img src="/images/pixel/star-pixel.svg" alt="" width="12" height="12" class="w-3 h-3 opacity-60 theme-icon" loading="lazy" decoding="async" />
    <span class="font-dm trim-caps text-[10px] tracking-[0.08em] uppercase text-muted-text">•</span>
    <img src="/images/pixel/heart-pixel.svg" alt="" width="12" height="12" class="w-3 h-3 opacity-60 theme-icon" loading="lazy" decoding="async" />
    <div class="h-px bg-line w-16 sm:w-24"></div>
  </div>
  <Writeups />
  <Journey />
  <Footer />
</Layout>
