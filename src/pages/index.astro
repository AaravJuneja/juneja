---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import TeamStory from "../components/TeamStory.astro";
import Writeups from "../components/Writeups.astro";
import Journey from "../components/Journey.astro";
import Footer from "../components/Footer.astro";
import ArcadeRunnerLane from "../components/react/ArcadeRunnerLane.tsx";
import SpotifyNowPlaying from "../components/react/SpotifyNowPlaying.tsx";
---

<Layout>
  <Navigation />
  <Hero />

  <div class="w-full max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-14 pb-2 flex flex-wrap gap-3 items-center">
    <SpotifyNowPlaying client:visible />
    <SocialLinks />
  </div>

  <div class="w-full max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-14 py-6">
    <ArcadeRunnerLane client:load />
  </div>

  <TeamStory />
  <Writeups />
  <Journey />
  <Footer />
</Layout>
