---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import InlineContact from "../components/InlineContact.astro";
---

<Layout>
  <div class="home-page relative">
    <div class="marble-bg" aria-hidden="true">
      <img src="/images/marble-bg.webp" alt="" width="735" height="496" loading="eager" fetchpriority="low" decoding="async" />
      <div class="marble-shade"></div>
      <div class="hotel-fade"></div>
    </div>
    <div class="hotel-bg" aria-hidden="true">
      <div class="hotel-shade"></div>
      <div class="hotel-fade"></div>
    </div>
    <div class="home-content relative">
      <Hero>
        <InlineContact slot="contact" embedded />
      </Hero>
    </div>
  </div>

</Layout>
