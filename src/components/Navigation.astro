---
const contactHref = Astro.url.pathname.startsWith("/journey") ? "#contact" : "/#contact";
---

<nav aria-label="Primary" class="w-full border-b border-line bg-background/80 sticky top-0 z-40 backdrop-blur-sm">
  <div id="scroll-progress" class="absolute top-0 left-0 h-[3px] w-full origin-left scale-x-0 bg-accent will-change-transform" aria-hidden="true"></div>
  <div class="w-full max-w-[1280px] mx-auto px-4 min-[400px]:px-6 sm:px-10 lg:px-12 flex items-center justify-between py-[14px] sm:py-[16px]">
    <a href="/#player" aria-label="Home" title="Home" class="inline-flex min-h-[44px] w-10 shrink-0 items-center justify-center text-muted-text transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
        <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      </svg>
    </a>
    <ul class="w-auto flex items-center justify-center gap-0.5 min-[400px]:gap-1 sm:gap-5 list-none m-0 p-0">
      <li class="flex items-center"><a href="/#team" data-nav="team" class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text hover:text-accent transition-colors relative after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent hover:after:w-full aria-[current=true]:after:w-full after:transition-all after:duration-150 px-0 min-[400px]:px-1 sm:px-1.5 py-2 min-h-[44px] inline-flex items-center focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">TEAM</a></li>
      <li class="flex items-center"><a href="/#skills" data-nav="skills" class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text hover:text-accent transition-colors relative after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent hover:after:w-full aria-[current=true]:after:w-full after:transition-all after:duration-150 px-0 min-[400px]:px-1 sm:px-1.5 py-2 min-h-[44px] inline-flex items-center focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">SKILLS</a></li>
      <li class="flex items-center"><a href="/#writeups" data-nav="writeups" class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text hover:text-accent transition-colors relative after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent hover:after:w-full aria-[current=true]:after:w-full after:transition-all after:duration-150 px-0 min-[400px]:px-1 sm:px-1.5 py-2 min-h-[44px] inline-flex items-center focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">WRITEUPS</a></li>
      <li class="flex items-center"><a href="/#highlights" data-nav="highlights" class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text hover:text-accent transition-colors relative after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent hover:after:w-full aria-[current=true]:after:w-full after:transition-all after:duration-150 px-0 min-[400px]:px-1 sm:px-1.5 py-2 min-h-[44px] inline-flex items-center focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">POW</a></li>
      <li class="flex items-center"><a href={contactHref} data-nav="contact" class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text hover:text-accent transition-colors relative after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-accent hover:after:w-full aria-[current=true]:after:w-full after:transition-all after:duration-150 px-0 min-[400px]:px-1 sm:px-1.5 py-2 min-h-[44px] inline-flex items-center focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">CONTACT</a></li>
    </ul>
  </div>
</nav>
<script>
  const initNav = () => {
  if ((document.getElementById("scroll-progress") as HTMLElement | null)?.dataset.navBound) return;
  (document.getElementById("scroll-progress") as HTMLElement | null)?.setAttribute("data-nav-bound", "1");
  const bar = document.getElementById("scroll-progress");
  const links = Array.from(document.querySelectorAll("[data-nav]"));
  const sections = links
    .map((a) => document.getElementById(a.getAttribute("data-nav") || ""))
    .filter((el) => el !== null);
  const setActive = (id: string) => {
    links.forEach((a) => {
      const on = a.getAttribute("data-nav") === id;
      a.classList.toggle("text-accent", on);
      a.classList.toggle("text-text", !on);
      if (on) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  };
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let ticking = false;
  let atBottom = false;
  const onScroll = () => {
    atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) setActive("contact");
    if (reduce || ticking) return;
    ticking = true;
    window.requestAnimationFrame(() => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? window.scrollY / max : 0;
      if (bar) bar.style.transform = `scaleX(${p})`;
    });
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  if ("IntersectionObserver" in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(atBottom ? "contact" : e.target.id);
        });
      },
      { rootMargin: "-40% 0px -55% 0px" }
    );
    sections.forEach((s) => io.observe(s));
  }
  };
  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
