---
import { Image } from "astro:assets";
import nightImg from "../../public/images/pixel/night.jpg";
---

<section id="player" data-reveal class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 pt-6 pb-4 sm:pt-10 sm:pb-6 lg:pt-12 lg:pb-8">
  <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12">
    <!-- Left copy -->
    <div class="flex-1 flex flex-col gap-7">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-accent" style="letter-spacing:0.88px">CYBERSECURITY · CTF · READER</p>
      <h1 class="font-dm font-bold text-[clamp(38px,6vw,68px)] leading-[0.95] text-text" style="letter-spacing:-2.04px; line-height:0.98">AARAV<br />JUNEJA</h1>
      <p class="font-outfit text-[clamp(18px,2.1vw,21px)] leading-[1.55] text-muted-text max-w-[52ch] tracking-[-0.005em]">Learning by breaking, understanding by rebuilding</p>
      <p class="font-mono text-[13px] sm:text-[14px] text-muted-text" aria-hidden="true"><span class="text-accent">$</span> <span id="hero-typed">whoami</span><span class="animate-caret text-accent">_</span></p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="#journey" class="inline-flex items-center gap-3 bg-accent text-background px-4 py-3.5 font-dm text-[11px] leading-none tracking-[0.08em] uppercase hover:brightness-110 hover:-translate-x-px hover:-translate-y-px hover:shadow-[3px_3px_0px_0px_#DDBCF3] active:translate-x-0 active:translate-y-0 active:shadow-none transition-all duration-150 ease-out w-fit">
          VIEW CTF JOURNEY
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M4.66663 4.66602L11.3333 11.3327" stroke="#0A0710" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.3333 4.66602V11.3327H4.66663" stroke="#0A0710" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#writeups" class="font-dm text-[11px] tracking-[0.08em] uppercase text-accent hover:text-accent-soft transition-colors underline underline-offset-4 decoration-accent/30 hover:decoration-accent">READ WRITEUPS</a>
      </div>
    </div>

     <!-- Player HUD -->
    <div class="w-full lg:w-[340px] shrink-0 bg-surface border border-line p-6 flex flex-col gap-5">
      <div class="flex items-center justify-between">
        <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">PLAYER PROFILE</p>
        <img src="/images/trophy.svg" alt="" width="20" height="20" class="w-5 h-5" decoding="async" />
      </div>

      <Image src={nightImg} alt="Night sky" width={340} height={340} class="w-full h-auto object-cover" loading="eager" decoding="async" fetchpriority="high" />

      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <p class="font-outfit font-medium text-[14px] text-muted-text tracking-[0.01em]">CAPTURING SINCE</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-text">JUN 2025</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <div class="group inline-flex items-center gap-1.5 bg-raised-surface border border-line px-2.5 py-1.5 hover:border-accent/30 hover:-translate-y-px transition-all duration-150">
          <img src="/images/pixel/heart-pixel.svg" alt="" width="12" height="12" class="w-3 h-3 group-hover:scale-110 transition-transform duration-150" loading="lazy" decoding="async" fetchpriority="low" />
          <span class="font-dm text-[11px] leading-none tracking-[0.08em] uppercase text-text">REV</span>
        </div>
        <div class="inline-flex items-center bg-raised-surface border border-line px-2.5 py-1.5 hover:border-accent/30 hover:-translate-y-px transition-all duration-150">
          <span class="font-dm text-[11px] leading-none tracking-[0.08em] uppercase text-text">OSINT</span>
        </div>
        <div class="inline-flex items-center bg-raised-surface border border-line px-2.5 py-1.5 hover:border-accent/30 hover:-translate-y-px transition-all duration-150">
          <span class="font-dm text-[11px] leading-none tracking-[0.08em] uppercase text-text">Bruteforce</span>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const el = document.getElementById("hero-typed");
  const phrases = ["whoami", ":(){ :|:& };:", "sudo rm -rf --no-preserve-root /", "dd if=/dev/random of=/dev/sda", "mv / /dev/null", "mkfs.ext4 /dev/sda1"];
  if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let pi = 0;
    let ci = phrases[0].length;
    let deleting = true;
    const tick = () => {
      if (!el.isConnected) return;
      const full = phrases[pi];
      if (deleting) {
        ci -= 1;
        el.textContent = full.slice(0, Math.max(0, ci));
        if (ci <= 0) {
          deleting = false;
          pi = (pi + 1) % phrases.length;
          window.setTimeout(tick, 400);
          return;
        }
        window.setTimeout(tick, 40);
      } else {
        ci += 1;
        el.textContent = phrases[pi].slice(0, ci);
        if (ci >= phrases[pi].length) {
          deleting = true;
          window.setTimeout(tick, 1400);
          return;
        }
        window.setTimeout(tick, 65);
      }
    };
    window.setTimeout(tick, 1200);
  }
</script>
