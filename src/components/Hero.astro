---
import { Image } from "astro:assets";
import nightImg from "../assets/night.jpg";
---

<section id="player" data-reveal class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 pt-10 pb-4 sm:pt-14 sm:pb-6 lg:pt-16 lg:pb-8">
  <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12">
    <div class="flex-1 flex flex-col gap-7">
      <h1 class="font-outfit font-semibold text-[clamp(3rem,4vw,4.5rem)] tracking-[-0.03em] leading-[1] text-text">hi, i’m aarav</h1>
      <p class="font-outfit text-[clamp(19px,1.3vw,24px)] leading-[1.55] text-muted-text max-w-[42ch] tracking-[-0.005em]">i like figuring things out and trying whatever catches my attention</p>
    </div>

    <div id="player-card" class="w-full max-w-[340px] mx-auto lg:mx-0 lg:w-[340px] lg:shrink-0 min-w-0">
      <div id="night-mirror" class="relative w-full overflow-hidden outline-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2" role="button" tabindex="0" aria-label="Crescent moon portrait">
        <Image src={nightImg} alt="Pixel art of a crescent moon over a mountain range" width={340} height={340} densities={[1, 2]} sizes="(min-width: 1024px) clamp(340px, 25vw, 460px), 340px" class="w-full h-auto object-cover" loading="eager" decoding="async" fetchpriority="high" />
        <div id="night-refl" aria-hidden="true" class="absolute left-0 top-0 w-[19px] h-[19px] opacity-0 pointer-events-none will-change-transform">
          <img src="/cursors/cursor-pixel.svg" alt="" width="19" height="19" class="w-full h-full" style="transform:scaleX(-1)" loading="lazy" decoding="async" />
        </div>
        <svg id="night-cracks" aria-hidden="true" viewBox="0 0 320 320" preserveAspectRatio="none" class="absolute inset-0 w-full h-full pointer-events-none">
          <g id="night-crack-1" style="opacity:0" stroke="#a99eb0" stroke-width="1.5" fill="none">
            <path d="M160 0 L150 75 L165 150 L140 225 L155 320" />
            <path d="M150 75 L110 110 M165 150 L210 175" />
          </g>
          <g id="night-crack-2" style="opacity:0" stroke="#a99eb0" stroke-width="1.5" fill="none">
            <path d="M60 320 L100 225 L90 140 L120 50" />
            <path d="M100 225 L150 250 M90 140 L40 125" />
            <path d="M260 320 L230 235 L245 150 L220 60" />
            <path d="M230 235 L180 260" />
          </g>
          <g id="night-crack-3" style="opacity:0;stroke:var(--color-accent-soft)" stroke-width="2" fill="none">
            <path d="M0 160 L80 155 L160 168 L240 160 L320 165" />
            <path d="M160 168 L160 250 M80 155 L70 100" />
          </g>
        </svg>
        <div id="night-dim" class="absolute inset-0 bg-background/40 pointer-events-none" style="display:none"></div>
      </div>
    </div>
  </div>
</section>
<script>
  const initMirror = () => {
  const mirror = document.getElementById("night-mirror");
  if (!mirror || (mirror as HTMLElement).dataset.mirrorBound) return;
  (mirror as HTMLElement).dataset.mirrorBound = "1";
  const events=new AbortController();
  const dim = document.getElementById("night-dim");
  const refl = document.getElementById("night-refl");
  let seenPointer = false;
  const cracks = [
    document.getElementById("night-crack-1"),
    document.getElementById("night-crack-2"),
    document.getElementById("night-crack-3"),
  ];
  const BREAK_AT = 20000;
  const STAGES = [7000, 13000, 17000];
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const getCookie = (n: string) => (document.cookie.match(new RegExp("(?:^|;)\\s*" + n + "=([^;]*)")) || [])[1] || undefined;
  const setCookie = (n: string, v: string) => { try { document.cookie = n + "=" + v + "; max-age=31536000; path=/; SameSite=Lax"; } catch {} };
  const storedCracked = getCookie("mirror") === "cracked" || getCookie("portrait") === "claimed";
  let broken = storedCracked;
  let hovering = false;
  let holdStart: number | null = null;
  let keyHeld = false;
  let raf: number | null = null;
  let charge = 0;
  let prev = 0;
  const showCracks = (n: number) => {
    cracks.forEach((c, i) => { if (c) c.style.opacity = i < n ? "1" : "0"; });
  };
  const hotelImg = () => {
    const found = document.getElementById("hotel-img");
    if (found instanceof HTMLImageElement) {
      if (!found.src) found.src = "/images/new-hotel.webp";
      return found;
    }
    const img = document.createElement("img");
    img.id = "hotel-img";
    img.alt = "";
    img.width = 1000;
    img.height = 563;
    img.decoding = "async";
    img.src = "/images/new-hotel.webp";
    document.querySelector(".hotel-bg")?.prepend(img);
    return img;
  };
  const loadHotel = () => { hotelImg(); };
  if (broken) {
    showCracks(3);
    if (dim) dim.style.display = "block";
  }
  if (getCookie("portrait") === "claimed") loadHotel();
  const syncMirror=()=>{
    const cracked=getCookie("mirror")==="cracked"||getCookie("portrait")==="claimed";
    if(cracked===broken)return;
    broken=cracked;charge=prev=0;hovering=false;holdStart=null;keyHeld=false;
    mirror.classList.remove("mirror-flicker","mirror-shatter");
    showCracks(cracked?3:0);
    if(dim)dim.style.display=cracked?"block":"none";
    if(refl)refl.style.opacity="0";
    seenPointer=false;
    if(raf!==null) {cancelAnimationFrame(raf);raf=null;}
  };
  window.addEventListener("portrait:claimed",syncMirror,{signal:events.signal});
  window.addEventListener("portrait:cleared",syncMirror,{signal:events.signal});
  window.addEventListener("focus",syncMirror,{signal:events.signal});
  window.addEventListener("pageshow",syncMirror,{signal:events.signal});
  document.addEventListener("visibilitychange",syncMirror,{signal:events.signal});
  try {window.cookieStore?.addEventListener("change",syncMirror,{signal:events.signal});} catch {}
  const claim = () => {
    if (broken) return;
    broken = true;
    setCookie("mirror", "cracked");
    setCookie("portrait", "claimed");
    document.documentElement.setAttribute("data-portrait", "");
    loadHotel();
    showCracks(3);
    if (dim) dim.style.display = "block";
    if (refl) refl.style.opacity = "0";
    if (!reduced && mirror) {
      mirror.classList.remove("mirror-flicker","mirror-shatter");
      void mirror.offsetWidth;
      mirror.classList.add("mirror-shatter");
    }
    const hotelEl = hotelImg();
    const loaderEl = document.querySelector(".loader");
    const hideLoader = () => { if (loaderEl) loaderEl.classList.add("loader--hidden"); };
    if (!hotelEl.complete || hotelEl.naturalWidth === 0) {
      if (loaderEl) loaderEl.classList.remove("loader--hidden");
      hotelEl.addEventListener("load", hideLoader, { once: true });
      hotelEl.addEventListener("error", hideLoader, { once: true });
    }
    window.dispatchEvent(new CustomEvent("portrait:claimed"));
  };
  const loop = (ts: number) => {
    raf = null;
    if (!broken) {
      if (!prev) prev = ts;
      const dt = Math.min(0.1, Math.max(0, (ts - prev) / 1000));
      prev = ts;
      const charging = hovering || holdStart !== null || keyHeld;
      if(!charging) {charge=prev=0;showCracks(0);mirror.classList.remove("mirror-flicker");return;}
      const rate = keyHeld ? 2 : 1;
      charge = charging ? charge + dt * 1000 * rate : 0;
      const ms = charge;
      showCracks(ms > STAGES[2] ? 3 : ms > STAGES[1] ? 2 : ms > STAGES[0] ? 1 : 0);
      if (ms > STAGES[2]) {
        loadHotel();
        if (mirror) mirror.classList.toggle("mirror-flicker", !reduced);
      }
      if (ms >= BREAK_AT) claim();
    }
    if (!broken) raf = window.requestAnimationFrame(loop);
  };
  const kick = () => { if (raf === null && !broken) raf = window.requestAnimationFrame(loop); };
  let mirrorVisible = true;
  let visibility:IntersectionObserver|undefined;
  const onReflMove = (e: PointerEvent) => {
    if (!mirrorVisible) return;
    if (e.pointerType === "touch" || !mirror || !refl || broken) return;
    const rect = mirror.getBoundingClientRect();
    const px = e.clientX - rect.left;
    const py = e.clientY - rect.top;
    if (!seenPointer) { seenPointer = true; refl.style.opacity = "0.6"; }
    refl.style.transform = `translate(${rect.width - px - 19}px, ${py}px)`;
  };
  if (mirror) {
    window.addEventListener("pointermove", onReflMove, { passive: true,signal:events.signal });
    mirror.addEventListener("mouseenter", () => { hovering = true; kick(); },{signal:events.signal});
    mirror.addEventListener("mouseleave", () => { hovering = false; },{signal:events.signal});
    mirror.addEventListener("touchstart", () => { holdStart = performance.now(); kick(); }, { passive: true,signal:events.signal });
    mirror.addEventListener("touchend", () => { holdStart = null; },{signal:events.signal});
    mirror.addEventListener("touchcancel", () => { holdStart = null; },{signal:events.signal});
    mirror.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      if (!keyHeld) { keyHeld = true; kick(); }
    },{signal:events.signal});
    mirror.addEventListener("keyup", () => { keyHeld = false; },{signal:events.signal});
    mirror.addEventListener("blur", () => {keyHeld=false;holdStart=null;hovering=false;},{signal:events.signal});
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { hovering = false; holdStart = null; keyHeld = false; }
    },{signal:events.signal});
    if ("IntersectionObserver" in window) {
      visibility=new IntersectionObserver((es) => es.forEach((e) => { mirrorVisible = e.isIntersecting; }), { threshold: 0 });
      visibility.observe(mirror);
    }
  }
  document.addEventListener("astro:before-swap",()=>{events.abort();visibility?.disconnect();if(raf!==null)cancelAnimationFrame(raf);},{once:true,signal:events.signal});
  };
  initMirror();
  document.addEventListener("astro:page-load", initMirror);
</script>
