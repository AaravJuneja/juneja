---
const socials = [
  { href: "https://github.com/AaravJuneja", label: "GITHUB", icon: "/images/github-icon.svg" },
  { href: "https://linkedin.com/in/aaravjuneja", label: "LINKEDIN", icon: "/images/linkedin-icon.svg" },
  { href: "https://open.spotify.com/user/w443w4mluzrxuvjqd2014fgt4", label: "SPOTIFY", icon: "/images/spotify-icon.svg" },
  { href: "https://instagram.com/arv.ifrr", label: "INSTAGRAM", icon: "/images/instagram-icon.svg" },
];
---

<div class="flex flex-wrap gap-2.5 items-center">
  {socials.map((s) => (
    <a href={s.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-surface border border-line px-3 py-2.5 min-h-[44px] hover:border-accent transition-[color,border-color] duration-150 ease-out motion-reduce:transition-none">
      <img src={s.icon} alt="" width="18" height="18" class="w-[18px] h-[18px] theme-icon" loading="lazy" decoding="async" />
      <span class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-text">{s.label}</span>
    </a>
  ))}
</div>
