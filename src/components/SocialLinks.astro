---
const socials = [
  { href: "https://github.com/AaravJuneja", label: "GitHub" },
  { href: "https://linkedin.com/in/aaravjuneja", label: "LinkedIn" },
  { href: "https://open.spotify.com/user/w443w4mluzrxuvjqd2014fgt4", label: "Spotify" },
  { href: "https://instagram.com/arv.ifrr", label: "Instagram" },
];
---

<nav aria-label="Social links">
  <ul class="m-0 flex flex-wrap items-center gap-x-5 gap-y-0 p-0 list-none">
    {socials.map((s) => (
      <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center font-outfit text-base text-muted-text transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 motion-reduce:transition-none">{s.label}</a></li>
    ))}
  </ul>
</nav>
