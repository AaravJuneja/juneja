---
import { allAchievements } from "../data.ts";

const podiumTitles = ["Redfox CTF 2026", "picoMini", "HackZero", "cruXipher 2025"];
const podiums = podiumTitles.map((t) => allAchievements.find((a) => a.title === t)!).filter(Boolean);
const rankOf = (finish: string) => {
  const m = finish.match(/(\d+)(st|nd|rd|th)/);
  return m ? `${m[1]}${m[2]}`.toUpperCase() : "";
};
---

<section id="highlights" data-reveal class="w-full">
  <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-16 sm:py-20">
    <div class="max-w-[820px] flex flex-col gap-4 mb-11">
      <p class="font-dm trim-caps text-[11px] tracking-[0.08em] uppercase text-accent">HIGHLIGHTS</p>
      <h2 class="font-dm trim-caps font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">POW</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="group md:col-span-2 lg:col-span-2 bg-raised-surface border border-accent p-5 sm:p-6 flex flex-col gap-4">
        <h3 class="font-dm trim-caps font-bold text-[20px] sm:text-[22px] leading-tight text-text">FROM SCRAP TO SOLAR</h3>
        <p class="font-outfit text-[16px] leading-[1.55] text-muted-text tracking-[-0.003em]">First every home had its own dish, then whole societies shared one, then streaming killed the need. 12.65 million subscriptions died between 2021 and 2025, and the dishes went to scrap. This was one of them.</p>
        <p class="font-outfit text-[16px] leading-[1.55] text-muted-text tracking-[-0.003em]">A discarded TV dish rebuilt with mirror tiles into a solar cooker with a motion sensor that keeps birds away from the focal point.</p>
        <ul class="flex flex-col gap-2 border-t border-accent/35 pt-4 list-none m-0 p-0 pt-4">
          <li class="font-outfit text-[16px] leading-[1.5] tracking-[-0.003em] flex gap-2.5">
            <span class="text-accent" aria-hidden="true">+</span>
            <a href="https://www.sristi.org/storage/app/public/editor-images/Ignite-book-2022.pdf" target="_blank" rel="noopener noreferrer" class="text-text hover:text-accent transition-colors">ignited mind 2022, national winner</a>
          </li>
          <li class="font-outfit text-[16px] leading-[1.5] tracking-[-0.003em] flex gap-2.5">
            <span class="text-accent" aria-hidden="true">+</span>
            <a href="https://www.sih.gov.in/sih-2022-junior-edition-final-result" target="_blank" rel="noopener noreferrer" class="text-text hover:text-accent transition-colors">smart india hackathon junior 2022, finale, Rs 25,000</a>
          </li>
          <li class="font-outfit text-[16px] leading-[1.5] tracking-[-0.003em] flex gap-2.5">
            <span class="text-accent" aria-hidden="true">+</span>
            <a href="https://www.inspireawards-dst.gov.in/students_corner/states/haryana/2021-22/student_list/STList-1222202113426PM.pdf" target="_blank" rel="noopener noreferrer" class="text-text hover:text-accent transition-colors">inspire manak, state level, Rs 10,000</a>
          </li>
          <li class="font-outfit text-[16px] leading-[1.5] tracking-[-0.003em] flex gap-2.5">
            <span class="text-accent" aria-hidden="true">+</span>
            <span>youth ideathon 2022, top 1000</span>
          </li>
          <li class="font-outfit text-[16px] leading-[1.5] tracking-[-0.003em] flex gap-2.5">
            <span class="text-accent" aria-hidden="true">+</span>
            <span>felicitated national awardee by the chairperson, 2024</span>
          </li>
        </ul>
      </div>

      <div class="group md:col-span-2 lg:col-span-1 bg-raised-surface border border-line grid grid-cols-2">
        {podiums.map((p, i) => (
          <a href={p.href} target="_blank" rel="noopener noreferrer" class={`group/cell p-5 sm:p-6 flex flex-col gap-2 transition-all duration-150 hover:bg-surface ${i % 2 === 0 ? "border-r border-line" : ""} ${i < 2 ? "border-b border-line" : ""}`}>
            <span class="font-anton text-[32px] leading-none text-text group-hover/cell:text-accent transition-colors duration-150" aria-hidden="true">{rankOf(p.finish)}</span>
            <h3 class="font-dm trim-caps font-bold text-[15px] sm:text-[16px] leading-tight text-text">{p.title}</h3>
            <p class="font-outfit text-[14px] leading-[1.5] text-muted-text tracking-[-0.003em]">{p.finish}</p>
          </a>
        ))}
      </div>

      <div class="md:col-span-2 lg:col-span-3 flex flex-col md:flex-row gap-4">
      <div class="group bg-raised-surface border border-line p-5 sm:p-6 flex flex-col gap-3 hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150 w-full md:w-fit md:shrink-0">
        <h3 class="font-dm trim-caps font-bold text-[17px] sm:text-[18px] leading-tight text-text">NMTC FINALIST</h3>
        <p class="font-dm trim-caps text-[11px] tracking-[0.08em] uppercase text-muted-text">JUNIOR · BHASKARA · 2024</p>
        <p class="font-outfit text-[16px] leading-[1.55] text-muted-text tracking-[-0.003em] sm:whitespace-nowrap">56,595 took it. The top tenth moved on. I moved on.</p>
      </div>

      <div class="group bg-raised-surface border border-line p-5 sm:p-6 flex flex-col gap-3 hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150 flex-1">
        <h3 class="font-dm trim-caps font-bold text-[17px] sm:text-[18px] leading-tight text-text">DELHI TECH CIRCUIT PODIUMS</h3>
        <p class="font-dm trim-caps text-[11px] tracking-[0.08em] uppercase text-muted-text">2024 TO 2026</p>
        <p class="font-outfit text-[16px] leading-[1.55] text-muted-text tracking-[-0.003em]">hardware, robotics, ctf and cryptic hunt podiums across the delhi ncr circuit.</p>
      </div>
      </div>

      <a href="/journey" class="group md:col-span-2 lg:col-span-3 bg-transparent border border-dashed border-line p-5 sm:p-6 flex items-center justify-between gap-4 hover:border-accent/50 transition-colors duration-150">
        <div class="flex flex-col gap-1.5">
          <span class="font-dm trim-caps font-bold text-[17px] sm:text-[18px] text-text uppercase">THE FULL CTF JOURNEY</span>
        </div>
        <img src="/images/arrow-up-right.svg" alt="" width="18" height="18" class="w-[18px] h-[18px] opacity-60 group-hover:opacity-100 theme-icon group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-150" loading="lazy" decoding="async" />
      </a>
    </div>
  </div>
</section>
