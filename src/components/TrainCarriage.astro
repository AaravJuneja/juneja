---
import { interests } from "../data";
import { repositories as githubRepositories } from "../data/github-repositories.json";
import { skins } from "../lib/trainCatalog";
import { RADIO_STATIONS } from "../lib/trainRadio";
interface NotebookRepository {
  name: string;
  href: string;
  description: string | null;
  archived: boolean;
  lastCommitAt: string | null;
  usingPreviousCommit: boolean;
  commitHref: string | null;
  commitsHref: string | null;
}
const repositories: NotebookRepository[] = githubRepositories.filter(repo=>!repo.fork);
const commitDate = new Intl.DateTimeFormat("en",{dateStyle:"medium",timeZone:"UTC"});
---

  <section class="train-page" data-train aria-label="Night train carriage">
    <img data-train-image src="/train/night.webp" draggable="false" alt="Timber carriage with plum benches, warm opal lamps and a night view through framed windows." width="1120" height="700" loading="eager" decoding="async" fetchpriority="high" />
    <div data-train-canvas></div>
    <h1 class="sr-only">Night train</h1>
    <div class="train-reticle" aria-hidden="true">+</div>
    <span class="sr-only" data-train-interaction role="status" aria-live="polite"></span>
    <ul class="sr-only train-objects" aria-label="Carriage objects" data-train-objects>
      {([["case","Travel case",true],["notebooks","Notebooks",true],["radio","Radio",true],["cord","Light cord",false],["lamps","Lamps",true],["avatar","Torch catalog",true],["equipment:key","Brass key",false],["equipment:drawer","Desk drawer",false],["equipment:charm","Charm",false]] as const).map(([object,label,dialog])=><li><button type="button" data-train-object={object} aria-haspopup={dialog?"dialog":undefined}>{label}</button></li>)}
    </ul>
    <div class="train-sprint" data-train-stamina role="progressbar" aria-label="Sprint stamina" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" hidden><div data-train-stamina-fill></div></div>
    <nav class="train-menu" aria-label="Train menus">
      <button class="train-menu-button" data-train-catalog type="button" aria-haspopup="dialog" aria-controls="catalog-panel">Catalog</button>
      <button class="train-menu-button" data-train-graphics type="button" aria-label="Switch to high graphics" aria-pressed="false" disabled>High graphics</button>
      <button class="train-menu-button" data-train-sound type="button" aria-pressed="true">Sound on</button>
      <button class="train-menu-button" data-train-settings type="button" aria-haspopup="dialog" aria-controls="settings-panel" hidden>Settings</button>
      <button class="train-menu-button" data-train-keys type="button" aria-haspopup="dialog" aria-controls="keys-panel">Keys</button>
    </nav>
    <dl class="train-key-hints" aria-label="Quick controls">
      <div><dt>Crouch</dt><dd><kbd>C</kbd></dd></div>
      <div><dt>Sprint</dt><dd><kbd>Ctrl</kbd></dd></div>
      <div><dt>Torch</dt><dd><kbd>Q</kbd></dd></div>
    </dl>
    <div class="train-message" data-train-message>
      <p data-train-status role="status">Taking your seat…</p>
      <button data-train-retry type="button" hidden>Retry 3D</button>
    </div>
    <noscript><p class="train-noscript">Enable JavaScript to explore the carriage in 3D</p></noscript>
    <dialog id="travel-case" class="train-dialog" aria-labelledby="case-title">
      <div class="train-panel"><button class="train-close" data-close type="button" aria-label="Close travel case">×</button><h2 id="case-title" tabindex="-1">In my case</h2>
        {interests.map((interest,i)=><details class="train-interest" name="travel-case-interests" open={i===0}><summary>{interest.title}</summary><p>{interest.description}</p></details>)}
        <nav class="train-links" aria-label="More about Aarav"><a href="/team">My teams</a><a href="/writeups">Writeups</a><a href="/achievements">Achievements</a></nav>
        <a href="/train/credits.txt">Asset credits</a>
      </div>
    </dialog>
    <dialog id="lamp-panel" class="train-dialog" aria-labelledby="lamp-title">
      <div class="train-panel"><button class="train-close" data-close type="button" aria-label="Close lamp controls">×</button><h2 id="lamp-title" tabindex="-1">Lamplight</h2>
        <label>Lamp<select data-train-lamp>{["Pendant", "Sconce"].flatMap(kind=>[1,2,3].map(i=><option value={`NT_R02_Lamp_${kind}_0${i}`}>{kind} {i}</option>))}</select></label>
        <label><input data-train-lamp-on type="checkbox" checked /> Light on</label>
        <label>Color<select data-train-lamp-color><option value="#ffffff">Amber</option><option value="#ff89bc">Rose</option><option value="#b5b5ff">Lavender</option></select></label>
      </div>
    </dialog>
    <dialog id="notebook-panel" class="train-dialog" aria-labelledby="notebook-title">
      <div class="train-panel">
        <button class="train-close" data-close type="button" aria-label="Close notebooks">×</button>
        <h2 id="notebook-title" tabindex="-1">Notebooks</h2>
        <p class="train-lede">Public repositories, sorted by commit date</p>
        {repositories.map(repo=><article class="train-repository">
          <h3><a href={repo.href} target="_blank" rel="noopener noreferrer">{repo.name}</a></h3>
          <div class="train-repository-meta">{repo.lastCommitAt ? <>{repo.usingPreviousCommit ? "Previous commit" : "Last commit"} <a href={repo.commitHref ?? repo.commitsHref ?? `${repo.href}/commits/`} target="_blank" rel="noopener noreferrer"><time datetime={repo.lastCommitAt}>{commitDate.format(new Date(repo.lastCommitAt))}</time></a></> : repo.usingPreviousCommit ? "No earlier commit" : "No commits yet"}{repo.archived && <span>Archived</span>}</div>
          {repo.description && <p>{repo.description.replace(/\.$/, "")}</p>}
        </article>)}
        <a href="https://github.com/AaravJuneja?tab=repositories" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </dialog>
    <dialog id="catalog-panel" class="train-dialog train-catalog-dialog" aria-labelledby="catalog-title">
      <div class="train-panel">
        <button class="train-close" data-close type="button" aria-label="Close catalog">×</button>
        <h2 id="catalog-title" tabindex="-1">Catalog</h2>
        <p class="train-lede">Choose your torch finish.</p>
        <div class="train-catalog-layout">
        <section class="train-catalog-content" aria-label="Torch skins">
          <div class="train-skin-grid" data-train-skins>
            {skins.map(skin=><button class="train-skin-card" type="button" data-train-skin={skin.id} data-pattern={"pattern" in skin ? skin.pattern : "solid"} style={`--skin-a:${skin.colors[0]};--skin-b:${skin.colors[1]}`} aria-pressed="false">
              <span class="train-skin-swatch" aria-hidden="true"></span><span>{skin.label}</span>
            </button>)}
          </div>
        </section>
        <aside class="train-catalog-detail" aria-label="Selected item">
          <div class="train-skin-card train-detail-preview" data-train-detail-preview aria-hidden="true"><span class="train-skin-swatch"></span></div>
          <h3 data-train-detail-title>Yellow</h3>
          <p data-train-detail-description>Recreated flashlight finish.</p>
        </aside>
        </div>
        <p class="train-catalog-status" data-train-catalog-status role="status" aria-live="polite" hidden></p>
      </div>
    </dialog>
    <dialog id="settings-panel" class="train-dialog train-settings-dialog" aria-labelledby="settings-title">
      <div class="train-panel">
        <button class="train-close" data-close type="button" aria-label="Close settings">×</button>
        <h2 id="settings-title" tabindex="-1">Settings</h2>
        <p class="train-lede">Your character for this trip.</p>
        <label class="train-avatar-setting">Avatar<select data-train-avatar><option value="sniqr">Sniqr</option></select></label>
        <p class="train-avatar-status-inline" data-train-avatar-status-inline role="status" aria-live="polite" hidden></p>
      </div>
    </dialog>
    <dialog id="keys-panel" class="train-dialog train-keys-dialog" aria-labelledby="keys-title">
      <div class="train-panel">
        <button class="train-close" data-close type="button" aria-label="Close keys">×</button>
        <h2 id="keys-title" tabindex="-1">Keys</h2>
        <p class="train-lede">Click the carriage to take control.</p>
        <dl class="train-key-list">
          <div><dt><kbd>Space</kbd></dt><dd>Jump; press again to double jump</dd></div>
          <div><dt><kbd>Shift</kbd></dt><dd>Toggle shift lock</dd></div>
          <div><dt><kbd>V</kbd></dt><dd>First or third person</dd></div>
          <div><dt><kbd>O</kbd></dt><dd>Free orbit or character aim</dd></div>
          <div><dt><kbd>E</kbd></dt><dd>Interact</dd></div>
          <div><dt><kbd>Esc</kbd></dt><dd>Release mouse lock or close a menu</dd></div>
        </dl>
        <p class="train-touch-help">On touch screens, drag to look. Drag with two fingers to walk, farther to sprint. Double tap empty space to jump.</p>
      </div>
    </dialog>
    <dialog id="radio-panel" class="train-dialog train-radio-dialog" aria-labelledby="radio-title">
      <div class="train-panel">
        <button class="train-close" data-close type="button" aria-label="Close radio">×</button>
        <h2 id="radio-title" tabindex="-1">Carriage radio</h2>
        <div class="radio-display">
          <span class="radio-indicator" data-train-radio-light aria-hidden="true"></span>
          <p class="radio-track" data-train-radio-title>Connecting to the player…</p>
          <p data-train-radio-status role="status" aria-live="polite">Waiting for the player</p>
          <div class="radio-tuner" aria-hidden="true"><span>88</span><span>92</span><span>96</span><span>100</span><span>104</span><span>108</span><i data-train-radio-needle></i></div>
        </div>
        <div class="radio-transport">
          <button type="button" data-train-radio-play disabled>Play</button>
          <button type="button" data-train-radio-next disabled>Next track</button>
        </div>
        <label>Listen to<select data-train-radio-mode disabled><option value="playlist">My playlist</option><option value="live">Live radio</option></select></label>
        <label data-train-radio-station-row hidden>Station<select data-train-radio-station>{RADIO_STATIONS.map(station=><option value={station.id}>{station.name}</option>)}</select></label>
        <label class="radio-volume">Volume<input data-train-radio-volume type="range" min="0" max="100" value="100" aria-label="Radio volume" disabled /><output data-train-radio-volume-value>100%</output></label>
        <p class="train-lede radio-help" data-train-radio-volume-help hidden>Use your device volume buttons.</p>
        <p class="train-lede radio-help" data-train-radio-info>Music stays with you when you leave the carriage.</p>
        <a data-train-radio-link target="_blank" rel="noopener noreferrer" hidden>Visit station</a>
      </div>
    </dialog>
    <input class="train-private-input" data-train-private-input type="password" aria-label="Input" tabindex="-1" maxlength="512" autocomplete="off" autocapitalize="off" spellcheck="false" />
  </section>

<script>
  import { skins } from "../lib/trainCatalog";
  import { createTrainAudio } from "../lib/trainAudio";
  import { readGraphicsPreference,saveGraphicsPreference } from "../lib/trainGraphics";
  import {RADIO_STATIONS,defaultRadioSource,radioStation,type RadioCommand,type RadioState} from "../lib/trainRadio";
  import type { EquipmentEvent } from "../lib/trainEquipment";
  const OBJECT_NAMES:Record<string,string>={case:"Travel case",radio:"Radio",cord:"Light cord",notebooks:"Notebooks","equipment:key":"Brass key","equipment:drawer":"Desk drawer","equipment:charm":"Charm"};
  const EQUIPMENT_MESSAGES:Record<EquipmentEvent,string>={key:"Picked up a small brass key.",locked:"The drawer is locked.",open:"The drawer slides open. Something glints inside.",close:"Drawer closed.",charm:"A little brass charm catches the light.",none:"Nothing to do there right now."};
  const EQUIPMENT_SOUNDS={key:"key",locked:"locked",open:"drawer-open",close:"drawer-close",charm:"charm"} as const;
  function initTrain() {
    const root = document.querySelector<HTMLElement>("[data-train]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    const get = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-train-${name}]`)!;
    const retry = get<HTMLButtonElement>("retry");
    const image = get<HTMLImageElement>("image");
    const status = get<HTMLElement>("status");
    const message = get<HTMLElement>("message");
    const interaction=get<HTMLElement>("interaction");
    const reticle=root.querySelector<HTMLElement>(".train-reticle")!;
    const catalogButton = get<HTMLButtonElement>("catalog");
    const graphicsButton=get<HTMLButtonElement>("graphics");
    const settingsButton=get<HTMLButtonElement>("settings");
    const keysButton=get<HTMLButtonElement>("keys");
    const stamina = get<HTMLElement>("stamina");
    const staminaFill = get<HTMLElement>("stamina-fill");
    const caseDialog = root.querySelector<HTMLDialogElement>("#travel-case")!;
    const lampDialog = root.querySelector<HTMLDialogElement>("#lamp-panel")!;
    const notebookDialog = root.querySelector<HTMLDialogElement>("#notebook-panel")!;
    const catalogDialog = root.querySelector<HTMLDialogElement>("#catalog-panel")!;
    const settingsDialog=root.querySelector<HTMLDialogElement>("#settings-panel")!;
    const keysDialog=root.querySelector<HTMLDialogElement>("#keys-panel")!;
    const radioDialog=root.querySelector<HTMLDialogElement>("#radio-panel")!;
    const lamp = get<HTMLSelectElement>("lamp");
    const lampOn = get<HTMLInputElement>("lamp-on");
    const lampColor = get<HTMLSelectElement>("lamp-color");
    const avatarSelect = get<HTMLSelectElement>("avatar");
    const catalogStatus = get<HTMLElement>("catalog-status");
    const avatarStatus = get<HTMLElement>("avatar-status-inline");
    const detailTitle=get<HTMLElement>("detail-title");
    const detailDescription=get<HTMLElement>("detail-description");
    const detailPreview=get<HTMLElement>("detail-preview");
    const showDetail=(label:string,description:string,skinId?:string)=>{
      detailTitle.textContent=label;
      detailDescription.textContent=description;
      const skin=skins.find(item=>item.id===skinId);
      detailPreview.hidden=!skin;
      if(skin) {
        detailPreview.dataset.pattern="pattern" in skin?skin.pattern:"solid";
        detailPreview.style.setProperty("--skin-a",skin.colors[0]);
        detailPreview.style.setProperty("--skin-b",skin.colors[1]);
      }
    };
    const privateInput=get<HTMLInputElement>("private-input");
    const dialogs = [caseDialog,lampDialog,notebookDialog,catalogDialog,settingsDialog,keysDialog,radioDialog];
    const lamps = new Map<string,{enabled:boolean;color:string}>();
    let session: Awaited<ReturnType<typeof import("../lib/trainScene").mountTrainScene>> | undefined;
    let request: AbortController | undefined;
    let avatarStatusMessage = "";
    let accessCheck = 0;
    let opener: HTMLElement | null = null;
    let holdTimer: number | undefined;
    let holdPointer: { id: number; x: number; y: number } | undefined;
    let suppressCatalogClickUntil = 0;
    let blindActive=false;
    let blindTimer:number|undefined;
    let blindOpener:HTMLElement|null=null;
    let blindRequest:AbortController|undefined;
    let graphicsQuality:"low"|"high"="low";
    try {graphicsQuality=readGraphicsPreference(sessionStorage);} catch {}
    const syncGraphicsButton=()=>{
      const next=graphicsQuality==="low"?"high":"low";
      graphicsButton.textContent=`${next[0].toUpperCase()}${next.slice(1)} graphics`;
      graphicsButton.setAttribute("aria-label",`Switch to ${next} graphics`);
      graphicsButton.setAttribute("aria-pressed",String(graphicsQuality==="high"));
    };
    syncGraphicsButton();
    const setCatalogStatus = (value: string) => {
      catalogStatus.textContent = value;
      catalogStatus.hidden = !value;
    };
    const syncAvatarStatus = () => {
      avatarStatus.textContent = avatarStatusMessage;
      avatarStatus.hidden = !avatarStatusMessage || !settingsDialog.open;
    };
    const syncCatalog = () => {
      const equipment = session?.getEquipment();
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-train-skin]")) {
        button.setAttribute("aria-pressed", String(equipment?.skin === button.dataset.trainSkin));
      }
      const skin=skins.find(item=>item.id===equipment?.skin)??skins.find(item=>item.id==="yellow")!;
      showDetail(skin.label,"Recreated flashlight finish. Select a skin to equip it.",skin.id);
    };
    const syncSettings=()=>{
      avatarSelect.value=session?.getAvatarControls().avatar??"sniqr";
      syncAvatarStatus();
    };
    const applyAvatarAccess = (unlocked: boolean,label?:unknown) => {
      settingsButton.hidden=!unlocked;
      const option = avatarSelect.querySelector<HTMLOptionElement>('option[value="private"]');
      const displayName=typeof label==="string"&&label.trim()?label.trim().slice(0,80):"Unlocked avatar";
      if (unlocked && !option) avatarSelect.add(new Option(displayName,"private"));
      else if(unlocked&&option)option.textContent=displayName;
      if (!unlocked) {
        option?.remove();
        if (avatarSelect.value === "private" || session?.getAvatarControls().avatar === "private") {
          avatarSelect.value = "sniqr";
          if (session) void session.setAvatar("sniqr");
        }
        if(settingsDialog.open)closeDialog(settingsDialog);
      }
      syncSettings();
    };
    const events = new AbortController();
    let radioState:RadioState|undefined;
    const radioPlay=get<HTMLButtonElement>("radio-play");
    const radioNext=get<HTMLButtonElement>("radio-next");
    const radioMode=get<HTMLSelectElement>("radio-mode");
    const radioStationSelect=get<HTMLSelectElement>("radio-station");
    const radioVolume=get<HTMLInputElement>("radio-volume");
    const commandRadio=(detail:RadioCommand)=>window.dispatchEvent(new CustomEvent("music:command",{detail}));
    const syncRadio=()=>{
      if(!radioState)return;
      const state=radioState;
      const station=radioStation(state.source);
      const live=!!station;
      radioPlay.disabled=false;radioMode.disabled=false;
      radioPlay.textContent=state.playing||state.loading?"Pause":"Play";
      radioPlay.setAttribute("aria-pressed",String(state.playing));
      radioNext.disabled=live;
      radioMode.value=live?"live":"playlist";
      if(station)radioStationSelect.value=station.id;
      get("radio-station-row").hidden=!live;
      get("radio-title").textContent=state.title;
      get("radio-status").textContent=state.error?"No signal. Press play to retry, or choose another source.":state.loading?"Tuning in…":state.playing?state.volume===0?"Muted":"On air":"Paused";
      get("radio-light").dataset.active=String(state.playing&&state.volume>0);
      get("radio-needle").style.left=station?`${16+RADIO_STATIONS.indexOf(station)*31}%`:"50%";
      radioVolume.disabled=!state.volumeSupported;
      radioVolume.value=String(Math.round(state.volume*100));
      get("radio-volume-value").textContent=`${Math.round(state.volume*100)}%`;
      get("radio-volume-help").hidden=state.volumeSupported;
      get("radio-info").textContent=station?`${station.description}. Live audio uses your internet connection; stopping disconnects the stream.`:"Music stays with you when you leave the carriage.";
      const link=get<HTMLAnchorElement>("radio-link");link.hidden=!station;
      if(station) {link.href=station.homepage;link.textContent=`Stream provided by ${station.provider}`;}
      session?.setRadioPlaying(state.playing&&!state.error&&state.volume>0);
    };
    window.addEventListener("music:state",event=>{radioState=event.detail;syncRadio();},{signal:events.signal});
    radioPlay.addEventListener("click",()=>commandRadio({action:"toggle"}),{signal:events.signal});
    radioNext.addEventListener("click",()=>commandRadio({action:"next"}),{signal:events.signal});
    radioVolume.addEventListener("input",()=>commandRadio({volume:Number(radioVolume.value)/100}),{signal:events.signal});
    radioMode.addEventListener("change",()=>commandRadio({source:radioMode.value==="playlist"?"playlist":defaultRadioSource(morning)}),{signal:events.signal});
    radioStationSelect.addEventListener("change",()=>{const station=radioStation(radioStationSelect.value);if(station)commandRadio({source:station.id});},{signal:events.signal});
    window.dispatchEvent(new CustomEvent("music:request-state"));
    const audio=createTrainAudio(events.signal);
    const soundButton=get<HTMLButtonElement>("sound");
    const syncSoundButton=()=>{
      const on=audio.isEnabled();
      soundButton.textContent=on?"Sound on":"Sound off";
      soundButton.setAttribute("aria-pressed",String(on));
    };
    syncSoundButton();
    const syncAmbience=()=>audio.setAmbience(root.dataset.live==="true"&&!document.hidden);
    const announce=(text:string)=>{interaction.textContent="";requestAnimationFrame(()=>{interaction.textContent=text;});};
    const equipmentEvent=(event:EquipmentEvent)=>{
      announce(EQUIPMENT_MESSAGES[event]);
      if(event!=="none")audio.play(EQUIPMENT_SOUNDS[event]);
    };
    root.addEventListener("pointerdown",()=>audio.unlock(),{capture:true,signal:events.signal});
    root.addEventListener("keydown",()=>audio.unlock(),{capture:true,signal:events.signal});
    root.querySelector(".train-menu")!.addEventListener("click",event=>{
      if(performance.now()>=suppressCatalogClickUntil&&event.target instanceof Element&&event.target.closest("button"))audio.play("tick");
    },{signal:events.signal});
    soundButton.addEventListener("click",()=>{
      audio.setEnabled(!audio.isEnabled());
      syncSoundButton();
      syncAmbience();
    },{signal:events.signal});
    document.addEventListener("visibilitychange",syncAmbience,{signal:events.signal});
    const refreshAccess = async (): Promise<boolean | undefined> => {
      const token = ++accessCheck;
      try {
        const response = await fetch("/api/train/access", { credentials: "same-origin", cache: "no-store", signal: events.signal });
        if (token !== accessCheck) return undefined;
        if (response.status === 401 || response.status === 403) { applyAvatarAccess(false); return false; }
        if (!response.ok) return undefined;
        const result = await response.json() as { unlocked?: unknown;avatar?:{label?:unknown} } | null;
        if (token === accessCheck && typeof result?.unlocked === "boolean") {
          applyAvatarAccess(result.unlocked,result.avatar?.label);
          return result.unlocked;
        }
        return undefined;
      } catch {
        return undefined;
      }
    };
    const closeDialog = (dialog:HTMLDialogElement) => {
      if (dialog.open) dialog.close();
      session?.setSuspended(dialogs.some(panel=>panel.open));
      const target = opener;
      opener = null;
      if(target&&target.getClientRects().length)target.focus({preventScroll:true});
      else catalogButton.focus({preventScroll:true});
      syncAvatarStatus();
    };
    const openDialog = (dialog: HTMLDialogElement) => {
      if (blindActive||dialogs.some(panel=>panel.open)) return;
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (document.pointerLockElement) document.exitPointerLock();
      session?.setSuspended(true);
      dialog.showModal();
      dialog.querySelector<HTMLElement>("h2")?.focus();
      if(dialog===catalogDialog)syncCatalog();
      if(dialog===settingsDialog) {syncSettings();void refreshAccess();}
    };
    const endBlindInput=()=>{
      if(blindTimer!==undefined)window.clearTimeout(blindTimer);
      blindTimer=undefined;
      privateInput.value="";
      if(!blindActive)return;
      blindActive=false;
      privateInput.blur();
      session?.setSuspended(dialogs.some(panel=>panel.open));
      const target=blindOpener;
      blindOpener=null;
      if(target?.isConnected&&target.getClientRects().length)target.focus({preventScroll:true});
    };
    const resetBlindTimer=()=>{
      if(blindTimer!==undefined)window.clearTimeout(blindTimer);
      blindTimer=window.setTimeout(endBlindInput,20000);
    };
    const beginBlindInput=()=>{
      if(blindActive||blindRequest||dialogs.some(panel=>panel.open))return;
      blindOpener=document.activeElement instanceof HTMLElement?document.activeElement:null;
      blindActive=true;
      privateInput.value="";
      session?.setSuspended(true);
      privateInput.focus({preventScroll:true});
      resetBlindTimer();
    };
    const verifyBlindInput=async()=>{
      const code=privateInput.value;
      endBlindInput();
      if(!code||blindRequest)return;
      const pending=new AbortController();
      blindRequest=pending;
      const abort=()=>pending.abort();
      events.signal.addEventListener("abort",abort,{once:true});
      try {
        const response=await fetch("/api/train/unlock",{
          method:"POST",credentials:"same-origin",cache:"no-store",headers:{"Content-Type":"application/json"},body:JSON.stringify({code}),signal:pending.signal,
        });
        if(!response.ok||pending.signal.aborted||events.signal.aborted||document.hidden||!root.isConnected)return;
        const result=await response.json() as {unlocked?:unknown;avatar?:{label?:unknown}}|null;
        if(result?.unlocked===true&&!pending.signal.aborted) {
          accessCheck++;
          applyAvatarAccess(true,result.avatar?.label);
          openDialog(settingsDialog);
        }
      } catch {} finally {
        events.signal.removeEventListener("abort",abort);
        if(blindRequest===pending)blindRequest=undefined;
      }
    };
    const refreshLamp = () => {
      const state = lamps.get(lamp.value) ?? {enabled:true,color:"#ffffff"};
      lampOn.checked=state.enabled; lampColor.value=state.color;
    };
    const changeLamp = () => { const state={enabled:lampOn.checked,color:lampColor.value}; lamps.set(lamp.value,state); session?.setLamp(lamp.value,state.enabled,state.color); };
    const radio = () => {
      openDialog(radioDialog);
      window.dispatchEvent(new CustomEvent("music:request-state"));
    };
    const activate = (object: string) => {
      if (object==="case") openDialog(caseDialog);
      else if (object==="cord") toggleDay();
      else if (object==="radio") radio();
      else if (object==="notebooks") openDialog(notebookDialog);
      else if (object==="lamps") { refreshLamp(); openDialog(lampDialog); }
      else if (object==="avatar") openDialog(catalogDialog);
      else if (object.startsWith("equipment:")) { if (!session?.activateEquipment(object)) equipmentEvent("none"); }
      else if (object.startsWith("NT_R02_Lamp")) { lamp.value=object; refreshLamp(); openDialog(lampDialog); }
    };
    let morning = false;
    let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const syncMotion = () => {
      session?.setPaused(paused);
    };
    const toggleDay = () => {
      morning = !morning;
      image.src = `/train/${morning ? "morning" : "night"}.webp`;
      image.alt = `${morning ? "Morning" : "Night"} view of a timber carriage with plum benches and opal lamps.`;
      session?.setDay(morning);
    };
    const stop = () => {
      blindRequest?.abort();
      endBlindInput();
      request?.abort();
      request = undefined;
      session?.dispose();
      session = undefined;
      root.dataset.live = "false";
      syncAmbience();
      graphicsButton.disabled=true;
      syncGraphicsButton();
    };
    const fallback = () => {
      stop();
      status.textContent = "The carriage is shown as an image. 3D is unavailable right now";
      retry.hidden = false;
      retry.disabled = false;
      message.hidden = false;
    };
    const start = async () => {
      stop();
      const pending = new AbortController();
      request = pending;
      retry.disabled = true;
      status.textContent = "Taking your seat…";
      message.hidden = false;
      try {
        const { mountTrainScene } = await import("../lib/trainScene");
        if (pending.signal.aborted) return;
        const mounted = await mountTrainScene(get("canvas"), pending.signal, {
          failed:fallback, activate,
          equipment:equipmentEvent,
          sound(name,options){audio.play(name,options);},
          hover(object) {
            reticle.dataset.active=String(!!object);
            const name=object?OBJECT_NAMES[object]??"Lamp":"";
            interaction.textContent=object?`${name}. Press E to interact.`:"";
          },
          stamina(energy,sprinting,exhausted) {
            stamina.hidden=energy>=1&&!sprinting;
            stamina.setAttribute("aria-valuenow",String(Math.round(energy*100)));
            stamina.setAttribute("aria-valuetext",exhausted?"Recovering":`${Math.round(energy*100)}%`);
            stamina.dataset.exhausted=String(exhausted);
            staminaFill.style.transform=`scaleX(${energy})`;
          },
          avatarStatus(value) {
            avatarStatusMessage = value;
            syncAvatarStatus();
          },
        }, graphicsQuality);
        if (pending.signal.aborted) { mounted.dispose(); return; }
        session = mounted;
        syncRadio();
        graphicsQuality=session.getGraphics();
        syncGraphicsButton();
        graphicsButton.disabled=false;
        session.setDay(morning);
        syncMotion();
        for (const [name,state] of lamps) session.setLamp(name,state.enabled,state.color);
        if (blindActive||dialogs.some(dialog=>dialog.open)) session.setSuspended(true);
        syncCatalog();
        root.dataset.live = "true";
        syncAmbience();
        message.hidden = true;
      } catch {
        if (!pending.signal.aborted) {
          if(graphicsQuality==="high") {
            graphicsQuality="low";
            try {saveGraphicsPreference(sessionStorage,"low");} catch {}
            syncGraphicsButton();
            void start();
          } else fallback();
        }
      }
    };
    retry.addEventListener("click", start, { signal: events.signal });
    catalogButton.addEventListener("click",event=>{
      if (performance.now() < suppressCatalogClickUntil) { event.preventDefault(); return; }
      openDialog(catalogDialog);
    },{signal:events.signal});
    graphicsButton.addEventListener("click",()=>{
      if(!session||graphicsButton.disabled)return;
      const target=session;
      const next=graphicsQuality==="low"?"high":"low";
      graphicsButton.disabled=true;
      graphicsButton.textContent=`Loading ${next}…`;
      void target.setGraphics(next).then(loaded=>{
        if(loaded&&session===target) {
          graphicsQuality=next;
          try {saveGraphicsPreference(sessionStorage,next);} catch {}
        }
      }).catch(()=>{}).finally(()=>{
        if(session!==target)return;
        graphicsButton.disabled=false;
        syncGraphicsButton();
      });
    },{signal:events.signal});
    settingsButton.addEventListener("click",()=>openDialog(settingsDialog),{signal:events.signal});
    get<HTMLElement>("objects").addEventListener("click",event=>{
      const button=event.target instanceof Element?event.target.closest<HTMLButtonElement>("[data-train-object]"):null;
      if(button?.dataset.trainObject)activate(button.dataset.trainObject);
    },{signal:events.signal});
    keysButton.addEventListener("click",()=>openDialog(keysDialog),{signal:events.signal});
    const clearHold = () => {
      if (holdTimer !== undefined) window.clearTimeout(holdTimer);
      holdTimer = undefined;
      holdPointer = undefined;
    };
    catalogButton.addEventListener("pointerdown",event=>{
      if (event.button !== 0 || !event.isPrimary) return;
      clearHold();
      holdPointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
      try { catalogButton.setPointerCapture(event.pointerId); } catch {}
      holdTimer = window.setTimeout(()=>{
        holdTimer = undefined;
        suppressCatalogClickUntil = performance.now() + 700;
        beginBlindInput();
      },1600);
    },{signal:events.signal});
    catalogButton.addEventListener("pointermove",event=>{
      if (!holdPointer || event.pointerId !== holdPointer.id) return;
      if (Math.hypot(event.clientX-holdPointer.x,event.clientY-holdPointer.y)>14) clearHold();
    },{signal:events.signal});
    catalogButton.addEventListener("pointerup",event=>{if(holdPointer?.id===event.pointerId)clearHold();if(blindActive)privateInput.focus({preventScroll:true});},{signal:events.signal});
    catalogButton.addEventListener("pointercancel",clearHold,{signal:events.signal});
    catalogButton.addEventListener("lostpointercapture",clearHold,{signal:events.signal});
    document.addEventListener("keydown",event=>{
      if (event.ctrlKey && event.altKey && event.code === "KeyU" && !dialogs.some(dialog=>dialog.open)) {
        event.preventDefault();
        beginBlindInput();
      }
    },{signal:events.signal});
    root.querySelector<HTMLElement>("[data-train-skins]")!.addEventListener("click",event=>{
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-train-skin]") : null;
      if (!button) return;
      if (!session) { setCatalogStatus("The 3D controls are not ready yet."); return; }
      const id = button.dataset.trainSkin!;
      session.setSkin(id);
      audio.play("equip");
      syncCatalog();
      setCatalogStatus(`${skins.find(skin=>skin.id===id)?.label ?? "Skin"} equipped.`);
    },{signal:events.signal});
    avatarSelect.addEventListener("change",()=>{
      if (!session) { syncSettings();avatarStatusMessage="The 3D controls are not ready yet.";syncAvatarStatus();return; }
      if (avatarSelect.value === "private") {
        avatarSelect.disabled = true;
        void refreshAccess().then(allowed=>{
          avatarSelect.disabled = false;
          if (allowed !== true || !session) {
            syncSettings();
            avatarStatusMessage=allowed === false ? "Access expired. Unlock again to use this avatar." : "Could not verify access. Try again.";
            syncAvatarStatus();
            return;
          }
          void session.setAvatar("private").then(syncSettings);
        });
        return;
      }
      void session.setAvatar("sniqr").then(syncSettings);
    },{signal:events.signal});
    lamp.addEventListener("change",refreshLamp,{signal:events.signal});
    lampOn.addEventListener("change",changeLamp,{signal:events.signal});
    lampColor.addEventListener("change",changeLamp,{signal:events.signal});
    privateInput.addEventListener("keydown",event=>{
      event.stopPropagation();
      if(event.key==="Escape") {event.preventDefault();endBlindInput();}
      else if(event.key==="Enter") {event.preventDefault();void verifyBlindInput();}
    },{signal:events.signal});
    privateInput.addEventListener("input",()=>{if(blindActive)resetBlindTimer();},{signal:events.signal});
    privateInput.addEventListener("blur",endBlindInput,{signal:events.signal});
    window.addEventListener("blur",()=>{endBlindInput();blindRequest?.abort();},{signal:events.signal});
    document.addEventListener("visibilitychange",()=>{if(document.hidden){endBlindInput();blindRequest?.abort();}},{signal:events.signal});
    for (const dialog of dialogs) {
      dialog.querySelector("[data-close]")?.addEventListener("click",()=>closeDialog(dialog),{signal:events.signal});
      dialog.addEventListener("click",event=>{if(event.target===dialog)closeDialog(dialog);},{signal:events.signal});
      dialog.addEventListener("cancel",event=>{event.preventDefault();closeDialog(dialog);},{signal:events.signal});
      dialog.addEventListener("close",()=>{session?.setSuspended(blindActive||dialogs.some(panel=>panel.open));syncAvatarStatus();},{signal:events.signal});
    }
    void refreshAccess();
    matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", (event) => { paused = event.matches; syncMotion(); }, { signal: events.signal });
    document.addEventListener("astro:before-swap", () => { clearHold(); stop(); events.abort(); }, { once: true, signal: events.signal });
    window.addEventListener("pagehide", stop, { signal: events.signal });
    window.addEventListener("pageshow", (event) => { void refreshAccess(); if (event.persisted) void start(); }, { signal: events.signal });
    syncMotion();
    void start();
  }
  initTrain();
  document.addEventListener("astro:page-load", initTrain);
</script>

