  .train-skin-card[data-pattern="leaves"] .train-skin-swatch { background:radial-gradient(ellipse at 20% 30%,var(--skin-a) 0 15%,transparent 16%),radial-gradient(ellipse at 70% 70%,var(--skin-a) 0 17%,transparent 18%),var(--skin-b); }
