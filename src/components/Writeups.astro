---
import { repositories } from "../data.ts";
---

<section id="writeups" data-reveal class="w-full bg-surface border-b border-accent">
  <div class="w-full max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-14 py-16 sm:py-22">
    <div class="max-w-[820px] flex flex-col gap-4 mb-11">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">WRITEUPS</p>
      <h2 class="font-dm font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">PUBLIC CTF WRITEUPS</h2>
      <p class="font-geist text-[clamp(17px,2vw,19px)] leading-relaxed text-muted-text">Three public repositories documenting solved challenges,<br class="hidden sm:block" />official releases and the work behind the flags.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {repositories.map((repo) => (
        <a href={repo.href} target="_blank" rel="noopener noreferrer" class="group bg-raised-surface border border-accent p-5 sm:p-6 flex flex-col gap-6 hover:border-accent-soft hover:shadow-[8px_8px_0px_0px_#A869DB] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150 ease-out">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <img src="/images/github-icon.svg" alt="" width="18" height="18" class="w-[18px] h-[18px]" />
              <span class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">{repo.owner}</span>
            </div>
            <img src="/images/arrow-up-right.svg" alt="" width="18" height="18" class="w-[18px] h-[18px] opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-150" />
          </div>

          <div class="flex flex-col gap-3 flex-1">
            <h3 class="font-dm font-bold text-[17px] sm:text-[18px] leading-tight text-text break-words">{repo.title}</h3>
            <p class="font-geist text-[15px] leading-relaxed text-muted-text">{repo.summary}</p>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">{repo.coverage}</p>
          </div>

          <div class="h-px bg-accent/35"></div>

          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">
              <span class="w-1.5 h-1.5 bg-accent-soft rounded-full"></span>
              {repo.writeups}
            </span>
            <span class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">{repo.stars}</span>
            <span class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">{repo.language}</span>
            <span class="font-dm text-[10px] tracking-[0.08em] uppercase text-muted-text ml-auto">{repo.updated}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
