---

---

    <div class="mbox theme w-full max-w-[300px] mx-auto lg:mx-0 shrink-0">
      <div class="label box">
        <div class="inner" style="--paper:#151020;--ink:#f7f2fa;--second:#a869db;--h:340px">
          <div class="face front">
            <span class="sm">est. gurugram · registered trade mark</span>
            <svg class="m" style="--mw:96px" viewBox="0 0 100 72" aria-hidden="true">
              <ellipse cx="56" cy="38" rx="30" ry="22" fill="currentColor" />
              <circle cx="24" cy="32" r="16" fill="currentColor" />
              <path d="M12 36c-8 8-10 20-3 28 2 2 5 0 4-3-4-6-3-14 3-20z" fill="currentColor" />
              <ellipse cx="30" cy="30" rx="8" ry="11" fill="var(--second,#e7b63a)" opacity=".9" />
              <rect x="36" y="52" width="9" height="17" fill="currentColor" /><rect x="52" y="54" width="9" height="15" fill="currentColor" /><rect x="68" y="52" width="9" height="17" fill="currentColor" />
              <path d="M85 34l8 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <circle cx="18" cy="28" r="2" fill="var(--paper,#fff)" />
            </svg>
            <span class="t1">aarav<br />brand</span>
            <span class="rule"></span>
            <span class="sm">breaks &amp; rebuilds</span>
            <span class="dev" lang="hi">ठोंक बजाकर देखिए</span>
            <span class="corner" lang="hi">नक़ल से सावधान</span>
          </div>
        </div>
      </div>
    </div>

<style>
  .theme .sm {
    color: var(--color-accent);
  }
  .theme .dev {
    color: var(--color-muted-text);
  }
  .theme .corner {
    color: var(--color-muted-text);
  }
</style>
