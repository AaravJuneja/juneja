---
import { achievements2025Syndication, achievements2026Syndication, achievements2026Obscuri } from "../data.ts";

const chapters = [
  {
    id: "2025-syndication",
    badge: "2025",
    title: "THE rookie SEASON",
    team: "SYNDICATION",
    copy: "The journey began here: 12th in India, 251st worldwide and 219.890 rating points.",
    achievements: achievements2025Syndication,
  },
  {
    id: "2026-syndication",
    badge: "2026",
    title: "THE TRIO LEVELS UP",
    team: "SYNDICATION",
    copy: "Kept competing as a trio separate from the larger and experienced squad.",
    achievements: achievements2026Syndication,
  },
  {
    id: "2026-obscuri",
    badge: "2026",
    title: "LEVELING UP AGAIN",
    team: "0BSCURI7Y",
    copy: "Joined 0bscuri7y at the start of 2026 and climbed to #1 in India.",
    achievements: achievements2026Obscuri,
  },
];
---

<section id="journey" data-reveal class="w-full">
  <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 pt-20 sm:pt-24 pb-16 sm:pb-20">
    <div class="max-w-[820px] flex flex-col gap-4 mb-6">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-accent">RECEIPTS</p>
      <h2 class="font-dm font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">CTF ACHIEVEMENTS</h2>
      <p class="font-outfit text-[clamp(18px,2.1vw,21px)] leading-[1.55] text-muted-text tracking-[-0.005em]">Some sleepless nights and loads of caffeine</p>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center gap-3 bg-surface border border-dashed border-accent px-4 py-4 mb-8">
      <div class="flex items-center gap-3.5 flex-1">
        <img src="/images/medal.svg" alt="" width="20" height="20" class="w-5 h-5 theme-icon" loading="lazy" decoding="async" />
        <span class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">les réalisations</span>
      </div>
      <input id="journey-search" type="search" placeholder="FILTER EVENTS" autocomplete="off" spellcheck="false" aria-label="Filter events" class="w-full sm:w-[240px] bg-raised-surface border border-line px-3 py-2.5 font-dm text-[11px] tracking-[0.08em] uppercase text-text placeholder:text-muted-text/60 focus:border-accent focus:outline-none" />
    </div>

    <div class="sticky top-[56px] sm:top-[60px] z-30 py-3 bg-background/90 backdrop-blur-sm flex flex-wrap gap-2 mb-8">
      {chapters.map((ch) => (
        <a href={`#${ch.id}`} class="inline-flex items-center gap-2 bg-surface border border-line px-3 py-2 font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text hover:text-text hover:border-accent/40 transition-colors">
          {ch.badge} {ch.team}
        </a>
      ))}
    </div>

    <div class="flex flex-col gap-10 sm:gap-12">
      {chapters.map((ch, idx) => (
        <details id={ch.id} data-chapter class="group/details bg-transparent scroll-mt-36" open={idx === 0}>
          <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden">
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 group/details-summary">
              <div class="w-full sm:w-[170px] shrink-0 bg-accent flex flex-col items-center justify-center py-5 sm:py-6 border border-accent shadow-[4px_4px_0px_var(--color-raised-surface)] relative">
                <span class="font-dm text-[10px] leading-none tracking-[0.08em] uppercase text-background/60">YEAR</span>
                <span class="font-dm font-bold text-2xl leading-none text-background">{ch.badge}</span>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 sm:hidden font-dm text-background text-lg leading-none select-none !cursor-pointer group-open/details:rotate-180 transition-transform duration-200" style="cursor:pointer">⌄</span>
              </div>
              <div class="flex-1 bg-surface border border-line p-5 sm:p-6 flex flex-col gap-2.5 relative">
                <div class="flex items-center gap-3 pr-6 sm:pr-0">
                  <h3 class="font-dm font-bold text-[17px] sm:text-[18px] tracking-tight text-text uppercase">{ch.title}</h3>
                  <span class="inline-flex items-center bg-accent/10 border border-accent/20 px-2.5 py-1 font-dm text-[11px] tracking-[0.08em] uppercase text-accent">{ch.team}</span>
                </div>
                <p class="font-outfit text-[15px] sm:text-[16px] leading-[1.55] text-muted-text tracking-[-0.003em]">{ch.copy}</p>
                <span class="hidden sm:block absolute right-4 top-1/2 -translate-y-1/2 font-dm text-muted-text text-lg leading-none select-none !cursor-pointer group-open/details:rotate-180 transition-transform duration-200" style="cursor:pointer">⌄</span>
                <span class="sm:hidden absolute right-4 top-1/2 -translate-y-1/2 font-dm text-muted-text text-lg leading-none select-none !cursor-pointer group-open/details:rotate-180 transition-transform duration-200" style="cursor:pointer">⌄</span>
              </div>
            </div>
          </summary>
          <div class="flex flex-col divide-y divide-line border-t border-line mt-8">
            {ch.achievements.map((a) => (
              <div class="group journey-row flex flex-col sm:flex-row sm:items-stretch gap-4 sm:gap-5 py-5 sm:py-6 px-0 sm:px-4 hover:bg-[color-mix(in_srgb,var(--color-raised-surface)_50%,transparent)] transition-colors duration-150" data-search={`${a.title} ${a.organizer} ${a.team} ${a.dates}`.toLowerCase()}>
                <div class="w-full sm:w-[170px] shrink-0 bg-raised-surface border border-line p-4 flex flex-col justify-center items-center text-center gap-1.5 group-hover:border-accent/40 transition-colors duration-150 sm:min-h-[88px]">
                  <p class="font-dm font-bold text-[15px] text-text leading-none">{a.rating}</p>
                  <p class="font-outfit font-medium text-[13px] tracking-[0.02em] text-accent-soft uppercase">{a.source && a.source !== "-" ? a.source : ""}</p>
                </div>
                <div class="flex-1 flex flex-col gap-2.5 min-w-0">
                  <div class="flex flex-wrap items-center gap-3">
                    <a href={a.href} target="_blank" rel="noopener noreferrer" class="font-dm font-bold text-[16px] sm:text-[18px] text-text hover:text-accent transition-colors break-words">{a.title}</a>
                    <span class="ml-auto inline-flex items-center border border-line px-2 py-1 font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text group-hover:border-accent/30 transition-colors duration-150">{a.team}</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="font-outfit font-medium text-[14px] text-muted-text tracking-[-0.003em]">{a.dates}</span>
                    <span aria-hidden="true" class="font-outfit text-accent text-[18px] select-none leading-none">·</span>
                    <span class="font-outfit font-medium text-[14px] text-muted-text tracking-[-0.003em]">{a.scope}</span>
                  </div>
                  <p class="font-outfit font-medium text-[14px] text-muted-text tracking-[-0.003em]">{a.organizer}</p>
                  <p class="font-outfit text-[16px] sm:text-[17px] leading-[1.5] text-text tracking-[-0.005em]">{a.finish}</p>
                </div>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div id="journey-empty" class="hidden border border-dashed border-line px-4 py-10 mt-10 text-center font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">NO EVENTS MATCH THAT FILTER</div>
  </div>
</section>

<script>
  const input = document.getElementById("journey-search");
  const empty = document.getElementById("journey-empty");
  const rows = Array.from(document.querySelectorAll(".journey-row"));
  const boxes = Array.from(document.querySelectorAll("details[data-chapter]")) as HTMLDetailsElement[];
  const paint = () => {
    const q = ((input instanceof HTMLInputElement && input.value) || "").trim().toLowerCase();
    let shown = 0;
    rows.forEach((r) => {
      const hit = !q || (r.getAttribute("data-search") || "").includes(q);
      r.classList.toggle("hidden", !hit);
      if (hit) shown += 1;
    });
    boxes.forEach((d) => {
      const hits = Array.from(d.querySelectorAll(".journey-row")).filter(
        (r) => !r.classList.contains("hidden")
      ).length;
      d.classList.toggle("hidden", q !== "" && hits === 0);
      if (q && hits > 0) d.open = true;
    });
    if (empty) empty.classList.toggle("hidden", shown !== 0);
  };
  if (input) {
    input.addEventListener("input", paint);
    paint();
  }
</script>
