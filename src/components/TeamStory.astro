---
import MatchboxBrand from "./MatchboxBrand.astro";
---

<section id="team" data-reveal class="w-full bg-surface">
  <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-16 sm:py-20">
    <div class="flex flex-col lg:flex-row gap-10 items-center mb-11">
    <div class="max-w-[760px] flex-1 flex flex-col gap-4">
      <p class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-accent">TEAM</p>
      <h2 class="font-dm trim-caps font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">FROM A HIGH SCHOOL TRIO TO THE GLOBAL SCOREBOARD</h2>
      <p class="font-outfit text-[clamp(18px,2.1vw,21px)] leading-[1.55] text-muted-text tracking-[-0.005em]">Syndication is the CTF alias of Tech Syndicate. Across 2025 and 2026, our trio moved from celebrating #26 in picoCTF to the top of Indian CTF leaderboard.</p>
    </div>
      <MatchboxBrand />
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
      <div class="flex-1 flex flex-col gap-3.5 order-2 lg:order-1">
        <p class="font-dm trim-caps text-[12px] tracking-[0.08em] uppercase text-muted-text">TAP A LABEL TO FLIP</p>
        <div class="mbox theme">
          <div class="label ticket" data-flip tabindex="0" role="button" aria-pressed="false" aria-label="Syndication team label, activate to flip">
            <div class="inner" style="--paper:#1d1428;--ink:#f7f2fa;--second:#a869db">
              <div class="face front">
                <svg class="m" style="--mw:64px" viewBox="0 0 120 90" aria-hidden="true">
                  <path d="M10 60h100l-16 20H26z" fill="currentColor" />
                  <path d="M62 8v50h40z" fill="currentColor" />
                  <path d="M56 22v36H26z" fill="var(--second,#e7b63a)" />
                  <path d="M8 84c10-6 20-6 30 0s20 6 30 0 20-6 30 0" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" />
                </svg>
                <span class="t1" style="font-size:1.6rem">syndication</span>
                <span class="xs">2025-present</span>
              </div>
              <div class="face back">
                <a href="https://ctftime.org/team/395280/" target="_blank" rel="noopener">syndication on ctftime</a>
                <span class="made">the original</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mbox theme">
          <div class="label tin" data-flip tabindex="0" role="button" aria-pressed="false" aria-label="0bscuri7y team label, activate to flip">
            <div class="inner" style="--paper:#1d1428;--ink:#f7f2fa;--second:#a869db">
              <div class="face front">
                <i class="screw a"></i><i class="screw b"></i><i class="screw c"></i><i class="screw d"></i>
                <svg class="m" style="--mw:64px" viewBox="0 0 100 100" aria-hidden="true">
                  <circle cx="24" cy="28" r="13" fill="currentColor" /><circle cx="76" cy="28" r="13" fill="currentColor" />
                  <circle cx="50" cy="54" r="34" fill="currentColor" />
                  <circle cx="38" cy="48" r="5" fill="var(--paper,#fff)" /><circle cx="62" cy="48" r="5" fill="var(--paper,#fff)" />
                  <path d="M44 62h12l-6 8z" fill="var(--second,#e7b63a)" />
                  <path d="M50 24v12M38 28l5 10M62 28l-5 10M22 56l10 2M78 56l-10 2M24 66l10-2M76 66l-10-2" stroke="var(--paper,#fff)" stroke-width="3" stroke-linecap="round" />
                </svg>
                <span class="t2">0bscuri7y</span>
                <span class="xs">2026</span>
              </div>
              <div class="face back">
                <a href="https://ctftime.org/team/370140/" target="_blank" rel="noopener">0bscuri7y on ctftime</a>
                <span class="made">since january 2026</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Rating Grid -->
      <div class="w-full lg:w-[480px] shrink-0 grid grid-cols-2 gap-2 sm:gap-3.5 order-1 lg:order-2">
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm trim-caps font-bold text-[19px] sm:text-[22px] text-text tabular-nums group-hover:text-accent transition-colors duration-150" data-count="219.89" data-decimals="3">219.890</p>
          <p class="font-dm trim-caps text-[10px] sm:text-[12px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">2025 RATING POINTS</p>
        </div>
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm trim-caps font-bold text-[19px] sm:text-[22px] text-text tabular-nums group-hover:text-accent transition-colors duration-150"><span data-count="12" data-decimals="0" data-prefix="#">#12</span></p>
          <p class="font-dm trim-caps text-[10px] sm:text-[12px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">INDIA · 2025</p>
        </div>
        <div class="group bg-raised-surface border border-accent p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:shadow-[4px_4px_0px_0px_var(--color-accent)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm trim-caps font-bold text-[19px] sm:text-[22px] text-text tabular-nums" data-count="455.576" data-decimals="3">455.576</p>
          <p class="font-dm trim-caps text-[10px] sm:text-[12px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">0BSCURI7Y · 2026 RP</p>
        </div>
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm trim-caps font-bold text-[19px] sm:text-[22px] text-text group-hover:text-accent transition-colors duration-150">NOW #6</p>
          <p class="font-dm trim-caps text-[10px] sm:text-[12px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">PEAK #1 · INDIA 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initTeam = () => {
  document.querySelectorAll("[data-flip]").forEach((el) => {
    const card = el as HTMLElement;
    if (card.dataset.flipBound) return;
    card.dataset.flipBound = "1";
    const back = card.querySelector(".back") as HTMLElement | null;
    const front = card.querySelector(".front") as HTMLElement | null;
    const syncBack = () => {
      const on = card.classList.contains("flip");
      if (back) {
        back.setAttribute("aria-hidden", String(!on));
        if ("inert" in back) (back as HTMLElement & { inert: boolean }).inert = !on;
      }
      if (front && "inert" in front) (front as HTMLElement & { inert: boolean }).inert = on;
    };
    syncBack();
    const toggle = (e: Event) => {
      if ((e.target as HTMLElement).closest("a")) return;
      card.classList.toggle("flip");
      card.setAttribute("aria-pressed", String(card.classList.contains("flip")));
      syncBack();
    };
    card.addEventListener("click", toggle);
    card.addEventListener("keydown", (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== "Enter" && ke.key !== " ") return;
      ke.preventDefault();
      card.classList.toggle("flip");
      card.setAttribute("aria-pressed", String(card.classList.contains("flip")));
      syncBack();
    });
  });
  const nums = Array.from(document.querySelectorAll("[data-count]"));
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const expo = (p: number) => (p >= 1 ? 1 : 1 - Math.pow(2, -10 * p));
  const run = (el: Element, delay: number) => {
    const target = parseFloat(el.getAttribute("data-count") || "0");
    const decimals = parseInt(el.getAttribute("data-decimals") || "0", 10);
    const prefix = el.getAttribute("data-prefix") || "";
    if (reduced || !isFinite(target)) return;
    const dur = 1600;
    let start = 0;
    const step = (t: number) => {
      if (!start) start = t;
      const p = Math.min(1, Math.max(0, (t - start - delay) / dur));
      el.textContent = prefix + (target * expo(p)).toFixed(decimals);
      if (p < 1 && el.isConnected) window.requestAnimationFrame(step);
      else el.textContent = prefix + target.toFixed(decimals);
    };
    window.requestAnimationFrame(step);
  };
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target, nums.indexOf(e.target) * 120);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    nums.forEach((n) => {
      if ((n as HTMLElement).dataset.countBound) return;
      (n as HTMLElement).dataset.countBound = "1";
      io.observe(n);
    });
  }
  };
  initTeam();
  document.addEventListener("astro:page-load", initTeam);
  document.addEventListener("astro:after-swap", initTeam);
</script>
