---

<section id="team" data-reveal class="w-full bg-surface">
  <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-16 sm:py-20">
    <div class="max-w-[760px] flex flex-col gap-4 mb-11">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-accent">TEAM</p>
      <h2 class="font-dm font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">FROM A HIGH SCHOOL TRIO TO THE GLOBAL SCOREBOARD.</h2>
      <p class="font-outfit text-[clamp(18px,2.1vw,21px)] leading-[1.55] text-muted-text tracking-[-0.005em]">Syndication is the CTF alias of Tech Syndicate. Across 2025 and 2026, our trio moved from celebrating #26 in picoCTF to the top of Indian CTF leaderboard.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Chapters -->
      <div class="flex-1 flex flex-col gap-3.5">
        <div class="group bg-raised-surface border border-line p-5 sm:p-6 flex flex-col gap-3 hover:border-accent/20 hover:-translate-y-0.5 transition-all duration-150">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <div class="flex items-center gap-2 min-w-0">
              <img src="/images/pixel/cat-pixel.svg" alt="" width="16" height="16" class="w-4 h-4 group-hover:scale-110 transition-transform duration-150 theme-icon shrink-0" loading="lazy" decoding="async" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">SYNDICATION</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text shrink-0">2025-Present</p>
          </div>
          <p class="font-outfit text-[17px] leading-[1.5] text-muted-text tracking-[-0.003em]">og trio</p>
        </div>

        <div class="group bg-raised-surface border border-accent p-5 sm:p-6 flex flex-col gap-3 hover:shadow-[6px_6px_0px_0px_var(--color-accent)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <div class="flex items-center gap-2 min-w-0">
              <img src="/images/pixel/ghost-pixel.svg" alt="" width="16" height="16" class="w-4 h-4 theme-icon shrink-0" loading="lazy" decoding="async" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">0BSCURI7Y</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text shrink-0">2026</p>
          </div>
          <p class="font-outfit text-[17px] leading-[1.5] text-muted-text tracking-[-0.003em]">Invited at the start of 2026 to compete with an established Indian team</p>
        </div>
      </div>

      <!-- Rating Grid -->
      <div class="w-full lg:w-[480px] shrink-0 grid grid-cols-2 gap-3.5">
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text tabular-nums group-hover:text-accent transition-colors duration-150" data-count="219.89" data-decimals="3">219.890</p>
          <p class="font-dm text-[10px] sm:text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">2025 RATING POINTS</p>
        </div>
        <div class="group bg-raised-surface border border-accent p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:shadow-[4px_4px_0px_0px_var(--color-accent)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text tabular-nums" data-count="455.576" data-decimals="3">455.576</p>
          <p class="font-dm text-[10px] sm:text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">0BSCURI7Y · 2026 RP</p>
        </div>
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text tabular-nums group-hover:text-accent transition-colors duration-150"><span data-count="12" data-decimals="0" data-prefix="#">#12</span></p>
          <p class="font-dm text-[10px] sm:text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">INDIA · 2025</p>
        </div>
        <div class="group bg-raised-surface border border-line p-3 sm:p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text group-hover:text-accent transition-colors duration-150">PEAK #1</p>
          <p class="font-dm text-[10px] sm:text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-normal sm:whitespace-nowrap">NOW #5 · INDIA 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const nums = Array.from(document.querySelectorAll("[data-count]"));
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const expo = (p: number) => (p >= 1 ? 1 : 1 - Math.pow(2, -10 * p));
  const run = (el: Element, delay: number) => {
    const target = parseFloat(el.getAttribute("data-count") || "0");
    const decimals = parseInt(el.getAttribute("data-decimals") || "0", 10);
    const prefix = el.getAttribute("data-prefix") || "";
    if (reduced || !isFinite(target)) return;
    const dur = 1600;
    let start = 0;
    const step = (t: number) => {
      if (!start) start = t;
      const p = Math.min(1, Math.max(0, (t - start - delay) / dur));
      el.textContent = prefix + (target * expo(p)).toFixed(decimals);
      if (p < 1 && el.isConnected) window.requestAnimationFrame(step);
      else el.textContent = prefix + target.toFixed(decimals);
    };
    window.requestAnimationFrame(step);
  };
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target, nums.indexOf(e.target) * 120);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    nums.forEach((n) => io.observe(n));
  }
</script>
