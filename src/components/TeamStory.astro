---

<section id="team" data-reveal class="w-full bg-surface border-y border-line">
  <div class="w-full max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-14 py-16 sm:py-20">
    <div class="max-w-[760px] flex flex-col gap-4 mb-11">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">team</p>
      <h2 class="font-dm font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">FROM A HIGH SCHOOL TRIO TO THE GLOBAL SCOREBOARD.</h2>
      <p class="font-geist text-[clamp(17px,2vw,19px)] leading-relaxed text-muted-text">Syndication is the CTF alias of Tech Syndicate. Across 2025 and 2026, our trio moved from celebrating #26 in picoCTF to the top of Indian CTF leaderboard.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Chapters -->
      <div class="flex-1 flex flex-col gap-3.5">
        <div class="bg-raised-surface border border-line p-5 sm:p-6 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/images/pixel/cat-pixel.svg" alt="" width="16" height="16" class="w-4 h-4" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">SYNDICATION</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">2025-Present</p>
          </div>
          <p class="font-geist text-[16px] text-muted-text">og trio</p>
        </div>

        <div class="bg-raised-surface border border-accent p-5 sm:p-6 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/images/pixel/ghost-pixel.svg" alt="" width="16" height="16" class="w-4 h-4" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">0BSCURI7Y</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">2026</p>
          </div>
          <p class="font-geist text-[16px] text-muted-text">Invited at the start of 2026 to compete with an established Indian team</p>
        </div>
      </div>

      <!-- Rating Grid -->
      <div class="w-full lg:w-[420px] shrink-0 grid grid-cols-2 gap-3.5">
        <div class="bg-raised-surface border border-line p-5 flex flex-col gap-2">
          <p class="font-dm font-bold text-[22px] text-text">219.890</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight">2025 RATING POINTS</p>
        </div>
        <div class="bg-raised-surface border border-accent p-5 flex flex-col gap-2">
          <p class="font-dm font-bold text-[22px] text-text">455.576</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight">0BSCURI7Y · 2026 RP</p>
        </div>
        <div class="bg-raised-surface border border-line p-5 flex flex-col gap-2">
          <p class="font-dm font-bold text-[22px] text-text">#12</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight">INDIA · 2025</p>
        </div>
        <div class="bg-raised-surface border border-line p-5 flex flex-col gap-2">
          <p class="font-dm font-bold text-[22px] text-text">PEAK #1</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight">NOW #5 · INDIA 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>
