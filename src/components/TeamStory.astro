---
---

<section id="team" data-reveal class="w-full bg-surface">
  <div class="w-full max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-12 py-16 sm:py-20">
    <div class="max-w-[760px] flex flex-col gap-4 mb-11">
      <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-accent">TEAM</p>
      <h2 class="font-dm font-bold text-[clamp(26px,4vw,34px)] leading-tight text-text uppercase">FROM A HIGH SCHOOL TRIO TO THE GLOBAL SCOREBOARD.</h2>
      <p class="font-outfit text-[clamp(18px,2.1vw,21px)] leading-[1.55] text-muted-text tracking-[-0.005em]">Syndication is the CTF alias of Tech Syndicate. Across 2025 and 2026, our trio moved from celebrating #26 in picoCTF to the top of Indian CTF leaderboard.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Chapters -->
      <div class="flex-1 flex flex-col gap-3.5">
        <div class="group bg-raised-surface border border-line p-5 sm:p-6 flex flex-col gap-3 hover:border-accent/20 hover:-translate-y-0.5 transition-all duration-150">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/images/pixel/cat-pixel.svg" alt="" width="16" height="16" class="w-4 h-4 group-hover:scale-110 transition-transform duration-150" loading="lazy" decoding="async" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">SYNDICATION</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">2025-Present</p>
          </div>
          <p class="font-outfit text-[17px] leading-[1.5] text-muted-text tracking-[-0.003em]">og trio</p>
        </div>

        <div class="group bg-raised-surface border border-accent p-5 sm:p-6 flex flex-col gap-3 hover:shadow-[6px_6px_0px_0px_#A869DB] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/images/pixel/ghost-pixel.svg" alt="" width="16" height="16" class="w-4 h-4" loading="lazy" decoding="async" />
              <h3 class="font-dm font-bold text-[17px] sm:text-[18px] text-text">0BSCURI7Y</h3>
            </div>
            <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text">2026</p>
          </div>
          <p class="font-outfit text-[17px] leading-[1.5] text-muted-text tracking-[-0.003em]">Invited at the start of 2026 to compete with an established Indian team</p>
        </div>
      </div>

      <!-- Rating Grid -->
      <div class="w-full lg:w-[480px] shrink-0 grid grid-cols-2 gap-3.5">
        <div class="group bg-raised-surface border border-line p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text group-hover:text-accent transition-colors duration-150">219.890</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-nowrap">2025 RATING POINTS</p>
        </div>
        <div class="group bg-raised-surface border border-accent p-5 flex flex-col items-center justify-center gap-2 text-center hover:shadow-[4px_4px_0px_0px_#A869DB] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text">455.576</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-nowrap">0BSCURI7Y · 2026 RP</p>
        </div>
        <div class="group bg-raised-surface border border-line p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text group-hover:text-accent transition-colors duration-150">#12</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-nowrap">INDIA · 2025</p>
        </div>
        <div class="group bg-raised-surface border border-line p-5 flex flex-col items-center justify-center gap-2 text-center hover:border-accent/30 hover:-translate-y-0.5 transition-all duration-150">
          <p class="font-dm font-bold text-[22px] text-text group-hover:text-accent transition-colors duration-150">PEAK #1</p>
          <p class="font-dm text-[11px] tracking-[0.08em] uppercase text-muted-text leading-tight whitespace-nowrap">NOW #5 · INDIA 2026</p>
        </div>
      </div>
    </div>
  </div>
</section>
