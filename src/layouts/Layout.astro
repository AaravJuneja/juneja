---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Loader from "../components/react/Loader.tsx";
import RevealWatcher from "../components/react/RevealWatcher.tsx";
import SpotifyNowPlaying from "../components/SpotifyNowPlaying.astro";
import SiteDock from "../components/SiteDock.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  compact?: boolean;
}
const { title = "home", description = "Hi, I'm Aarav. I like figuring things out and trying whatever catches my attention.", noindex = false, compact = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://squeakyfiddlepro.me/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0710" />
    <meta name="author" content="Aarav Juneja" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="juneja" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://squeakyfiddlepro.me/images/og-card.png?v=2" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="juneja - cybersecurity CTF player profile" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [{ "@type": "WebSite", "@id": "https://squeakyfiddlepro.me/#website", url: "https://squeakyfiddlepro.me/", name: "juneja" }, { "@type": "Person", "@id": "https://squeakyfiddlepro.me/#person", name: "Aarav Juneja", url: "https://squeakyfiddlepro.me/", description, image: "https://squeakyfiddlepro.me/images/og-card.png", jobTitle: "Cybersecurity CTF player", sameAs: ["https://github.com/AaravJuneja", "https://linkedin.com/in/aaravjuneja", "https://ctftime.org/user/230373"] }] })} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://squeakyfiddlepro.me/images/og-card.png?v=2" />
    <meta name="twitter:image:alt" content="juneja - cybersecurity CTF player profile" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin-600-normal.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline data-astro-rerun>try{const claimed=/(?:^|;)\s*portrait=claimed(?:;|$)/.test(document.cookie);document.documentElement.toggleAttribute("data-portrait",claimed);document.querySelector('meta[name="theme-color"]')?.setAttribute("content",claimed?"#0d0906":"#0A0710")}catch{}</script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-background text-text antialiased overflow-x-clip">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999999] focus:bg-accent focus:text-background focus:px-3 focus:py-2 font-dm trim-caps text-[12px] tracking-[0.08em] uppercase">SKIP TO CONTENT</a>
    <Loader client:load />
    <RevealWatcher client:load />
    <main id="main-content" class="site-main overflow-x-clip" data-home={Astro.url.pathname === "/" || undefined} data-compact={compact || undefined} tabindex="-1">
      <slot />
    </main>
    <aside class="persistent-player" aria-label="Music player" transition:persist="spotify-player">
      <SpotifyNowPlaying />
    </aside>
    <SiteDock />
  </body>
</html>

<script>
  import {initPortraitTheme} from "../lib/portraitTheme";
  initPortraitTheme();
</script>

<style>
  .persistent-player {
    position: fixed;
    z-index: 50;
    right: max(12px, env(safe-area-inset-right, 0px));
    bottom: calc(60px + max(12px, env(safe-area-inset-bottom, 0px)));
    display: flex;
    width: min(340px, calc(100vw - 24px));
    height: 44px;
    justify-content: flex-end;
    overflow: visible;
    user-select: none;
    -webkit-user-select: none;
  }
  :global(body:has([data-train])) .persistent-player { display: none; }
</style>
