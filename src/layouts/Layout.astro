---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Loader from "../components/react/Loader.tsx";
import RevealWatcher from "../components/react/RevealWatcher.tsx";

interface Props {
  title?: string;
  description?: string;
}
const { title = "home", description = "Learning by breaking, understanding by rebuilding" } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://squeakyfiddlepro.me/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0710" />
    <meta name="author" content="Aarav Juneja" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="juneja" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://squeakyfiddlepro.me/images/og-card.png?v=2" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="juneja - cybersecurity CTF player profile" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [{ "@type": "WebSite", "@id": "https://squeakyfiddlepro.me/#website", url: "https://squeakyfiddlepro.me/", name: "juneja" }, { "@type": "Person", "@id": "https://squeakyfiddlepro.me/#person", name: "Aarav Juneja", url: "https://squeakyfiddlepro.me/", jobTitle: "Cybersecurity CTF player", sameAs: ["https://github.com/AaravJuneja"] }] })} />
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://squeakyfiddlepro.me/images/og-card.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-retrograde-700.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>try{if(/(?:^|;)\s*portrait=claimed(;|$)/.test(document.cookie))document.documentElement.setAttribute("data-portrait","")}catch{}</script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-background text-text antialiased overflow-x-clip">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999999] focus:bg-accent focus:text-background focus:px-3 focus:py-2 font-dm trim-caps text-[12px] tracking-[0.08em] uppercase">SKIP TO CONTENT</a>
    <Loader client:load />
    <RevealWatcher client:load />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
