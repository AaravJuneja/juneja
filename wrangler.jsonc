{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juneja",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-31",
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.glb"],
      "fallthrough": false
    }
  ],
  "ratelimits": [
    {
      "name": "TRAIN_UNLOCK_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/train/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
